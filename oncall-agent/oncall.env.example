# Copy to oncall.env and fill in. NEVER commit oncall.env (it is in .gitignore).
ONCALL_LLM_BASE_URL=https://api.groq.com/openai/v1
ONCALL_LLM_MODEL=llama-3.3-70b-versatile
ONCALL_LLM_API_KEY=paste-your-key-here

# Endpoints (defaults match the demo's docker compose)
ONCALL_PROM_URL=http://localhost:9090
ONCALL_JAEGER_URL=http://localhost:8080/jaeger/ui
ONCALL_ACTION_API_URL=http://127.0.0.1:8765
ONCALL_LOADGEN_URL=http://localhost:8080/loadgen

# Tuning
ONCALL_CONFIDENCE_THRESHOLD=0.55
ONCALL_MAX_LLM_STEPS=10
ONCALL_VERIFY_MINUTES=4
