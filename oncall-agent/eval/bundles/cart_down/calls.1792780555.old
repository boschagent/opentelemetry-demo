OR:  syntax error at or near \"$12\" at character 689\n2026-10-23T17:09:07.272580705Z 2026-10-23 17:09:07.271 UTC [772] STATEMENT:  /* otel-collector-ignore */ SET plan_cache_mode = force_generic_plan;PREPARE otel__4021484349309401941 AS SELECT\n2026-10-23T17:09:07.272585453Z \t    COALESCE(sa.datname, $1) AS datname,\n2026-10-23T17:09:07.272589251Z \t    COALESCE(sa.usename, $2) AS usename,\n2026-10-23T17:09:07.272592342Z \t    COALESCE(sa.client_addr::TEXT, $3) AS client_addr,\n2026-10-23T17:09:07.272595452Z \t    COALESCE(sa.client_hostname, $4) AS client_hostname,\n2026-10-23T17:09:07.272598394Z \t    COALESCE(sa.client_port::TEXT, $5) AS client_port,\n2026-10-23T17:09:07.272601495Z \t    COALESCE(sa.query_start::TEXT, $6) AS query_start,\n2026-10-23T17:09:07.272604468Z \t    COALESCE(sa.wait_event_type, $7) AS wait_event_type,\n2026-10-23T17:09:07.272607276Z \t    COALESCE(sa.wait_event, $8) AS wait_event,\n2026-10-23T17:09:07.272610121Z \t    COALESCE(sa.query_id::TEXT, $9) AS query_id,\n2026-10-23T17:09:07.272613069Z \t    COALESCE(sa.pid::TEXT, $10) AS pid,\n2026-10-23T17:09:07.272615961Z \t    COALESCE(sa.application_name::TEXT, $11) AS application_name,\n2026-10-23T17:09:07.272619076Z \t    EXTRACT($12 FROM sa.query_start) AS _query_start_timestamp,\n2026-10-23T17:09:07.272621991Z \t    sa.state,\n2026-10-23T17:09:07.272624746Z \t    sa.query,\n2026-10-23T17:09:07.272627459Z \t    CASE\n2026-10-23T17:09:07.272630298Z \t    WHEN sa.state = $13 THEN\n2026-10-23T17:09:07.272633267Z \t      EXTRACT($14 FROM (clock_timestamp() - sa.query_start)) * $15\n2026-10-23T17:09:07.272636214Z \t    WHEN sa.state IN ($16 /*, ... */)\n2026-10-23T17:09:07.272639021Z \t         AND sa.state_change IS NOT NULL THEN\n2026-10-23T17:09:07.272641873Z \t      EXTRACT($17 FROM (sa.state_change - sa.query_start)) * $18\n2026-10-23T17:09:07.272644804Z \t    ELSE\n2026-10-23T17:09:07.272647493Z \t      $19\n2026-10-23T17:09:07.272650243Z \t    END AS duration_ms,\n2026-10-23T17:09:07.272653065Z \t    -- Blocking info\n2026-10-23T17:09:07.272655962Z \t    COALESCE(pg_blocking_pids(sa.pid)::TEXT, $20) AS blocking_pids,\n2026-10-23T17:09:07.272658912Z \t    CASE WHEN bl.waitstart IS NOT NULL\n2026-10-23T17:09:07.272661730Z \t         THEN to_char(bl.waitstart AT TIME ZONE $21, $22)\n2026-10-23T17:09:07.272664833Z \t         ELSE $23 END AS blocking_start_time,\n2026-10-23T17:09:07.272687182Z \t    COALESCE(EXTRACT($24 FROM (clock_timestamp() - bl.waitstart))::BIGINT, $25) AS blocking_wait_duration,\n2026-10-23T17:09:07.272689770Z \t    COALESCE(bl.mode, $26) AS blocking_lock_mode,\n2026-10-23T17:09:07.272691918Z \t    COALESCE(bl.locktype, $27) AS blocking_lock_type,\n2026-10-23T17:09:07.272694091Z \t    COALESCE(c.relname, $28) AS blocking_lock_relation,\n2026-10-23T17:09:07.272696264Z \t    CASE WHEN sa.xact_start IS NOT NULL\n2026-10-23T17:09:07.272698425Z \t         THEN to_char(sa.xact_start AT TIME ZONE $29, $30)\n2026-10-23T17:09:07.272700491Z \t         ELSE $31 END AS blocking_transaction_start\n2026-10-23T17:09:07.272702651Z \tFROM pg_stat_activity sa\n2026-10-23T17:09:07.272704693Z \tLEFT JOIN LATERAL (\n2026-10-23T17:09:07.272706698Z \t  SELECT mode, locktype, relation, waitstart\n2026-10-23T17:09:07.272708850Z \t  FROM pg_locks\n2026-10-23T17:09:07.272710973Z \t  WHERE pid = sa.pid AND NOT granted\n2026-10-23T17:09:07.272714621Z \t  ORDER BY waitstart ASC NULLS LAST\n2026-10-23T17:09:07.272716793Z \t  LIMIT $32\n2026-10-23T17:09:07.272718832Z \t) bl ON $33\n2026-10-23T17:09:07.272720810Z \tLEFT JOIN pg_class c\n2026-10-23T17:09:07.272722907Z \t  ON  c.oid = bl.relation\n2026-10-23T17:09:07.272725007Z \tWHERE\n2026-10-23T17:09:07.272726969Z \t    coalesce(\n2026-10-23T17:09:07.272729727Z \t      TRIM(sa.query),\n2026-10-23T17:09:07.272731836Z \t      $34\n2026-10-23T17:09:07.272733731Z \t    ) != $35\n2026-10-23T17:09:07.272735752Z \t    \n2026-10-23T17:09:07.272737758Z \t    AND sa.pid != pg_backend_pid()\n2026-10-23T17:09:07.272739782Z \t    \n2026-10-23T17:09:07.272741717Z \t    AND sa.query_start IS NOT NULL\n2026-10-23T17:09:07.272743812Z \t    AND NOT (\n2026-10-23T17:09:07.272745774Z \t    \n2026-10-23T17:09:07.272747665Z \t      sa.query_start < TO_TIMESTAMP($36)\n2026-10-23T17:09:07.272749957Z \t      AND sa.state = $37\n2026-10-23T17:09:07.272752037Z \t      -- Keep idle-in-transaction sessions that are blocking others\n2026-10-23T17:09:07.272754227Z \t      AND sa.pid NOT IN (\n2026-10-23T17:09:07.272756214Z \t        SELECT unnest(pg_blocking_pids(pid))\n2026-10-23T17:09:07.272758292Z \t        FROM   pg_stat_activity\n2026-10-23T17:09:07.272760283Z \t        WHERE  cardinality(pg_blocking_pids(pid)) > $38\n2026-10-23T17:09:07.272762591Z \t      )\n2026-10-23T17:09:07.272764573Z \t    )\n2026-10-23T17:09:07.272766629Z \tLIMIT $39;\n2026-10-23T17:09:07.303643073Z 2026-10-23 17:09:07.302 UTC [772] ERROR:  prepared statement \"otel__4021484349309401941\" does not exist\n2026-10-23T17:09:07.303708161Z 2026-10-23 17:09:07.302 UTC [772] STATEMENT:  /* otel-collector-ignore */ DEALLOCATE PREPARE otel__4021484349309401941\n2026-10-23T17:09:08.376872280Z 2026-10-23 17:09:08.376 UTC [772] ERROR:  syntax error at or near \"$3\" at character 278\n2026-10-23T17:09:08.376915330Z 2026-10-23 17:09:08.376 UTC [772] STATEMENT:  /* otel-collector-ignore */ SET plan_cache_mode = force_generic_plan;PREPARE otel__3572901684491608047 AS SELECT\n2026-10-23T17:09:08.376919716Z \t\tcoalesce(cast(client_addr as varchar), $1) AS client_addr,\n2026-10-23T17:09:08.376923028Z \t\tcoalesce(pg_wal_lsn_diff(pg_current_wal_lsn(), replay_lsn), $2) AS replication_bytes_pending,\n2026-10-23T17:09:08.376925744Z \t\textract($3 from coalesce(write_lag, $4))::decimal AS write_lag_fractional,\n2026-10-23T17:09:08.376928125Z \t\textract($5 from coalesce(flush_lag, $6))::decimal AS flush_lag_fractional,\n2026-10-23T17:09:08.376930440Z \t\textract($7 from coalesce(replay_lag, $8))::decimal AS replay_lag_fractional\n2026-10-23T17:0